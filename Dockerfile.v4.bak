# universal-router Sprint 4 — multi-process container (v5.1)
# Runs universal-router on :9009 + FIVE specialist backends internally:
#   :9019 cybergym_agentx (v84)
#   :8080 agentx-osworld
#   :9020 pi_bench_agentx (v49)
#   :9021 malt_agentx (v26)
#   :8090 fwa_agentx (v1) — new in v5: VLM via GPT-5.4
#
# v5.1 FIX: fwa-agentx now built INSIDE the Debian container so its glibc
# symbol versions match the runtime stage. v5 copied a host-built binary
# which had GLIBC_2.38/2.39 symbols not present in Debian bookworm.

# ─── Stage 1: build universal-router (glibc) ──────────────────────────────────
FROM rust:1.94-slim-bookworm AS router-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
RUN cargo build --release

# ─── Stage 2: build fwa-agentx (glibc, matched to bookworm) ───────────────────
# We copy the entire fwa-agentx-rust source tree into the image and build
# from scratch here. This guarantees the resulting binary links against
# the SAME glibc version as the final stage (debian:bookworm-slim).
FROM rust:1.94-slim-bookworm AS fwa-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY fwa-agentx-src/Cargo.toml fwa-agentx-src/Cargo.lock* ./
COPY fwa-agentx-src/src ./src
RUN cargo build --release

# ─── Stage 3: source for cybergym_agentx binary (already glibc) ───────────────
FROM tenalirama2026/cybergym-agentx:v84 AS cybergym-source

# ─── Stage 4: source for pi_bench_agentx binary (glibc) ───────────────────────
FROM tenalirama2026/pi-bench-agentx:v49 AS pibench-source

# ─── Stage 5: source for malt_agentx binary (glibc) ───────────────────────────
FROM tenalirama2026/malt-agentx:v26 AS malt-source

# ─── Stage 6: final runtime — debian-slim with glibc + OpenSSL 3 + ffmpeg ─────
# v5.1: ffmpeg for FWA video frame extraction (best-effort, optional)
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libssl3 tini ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Router binary (newly built for glibc)
COPY --from=router-builder /build/target/release/universal-router /app/universal-router

# CyberGym specialist
COPY --from=cybergym-source /app/cybergym_agentx /app/cybergym_agentx

# Pi-Bench specialist + its ADC credentials JSON
COPY --from=pibench-source /app/pi_bench_agentx /app/pi_bench_agentx
COPY --from=pibench-source /app/adc-credentials.json /app/adc-credentials.json

# MALT specialist
COPY --from=malt-source /app/malt_agentx /app/malt_agentx

# OSWorld specialist (local binary in build context — pre-built static-pie)
COPY agentx-osworld /app/agentx-osworld

# FWA specialist (v5.1: built in fwa-builder stage)
COPY --from=fwa-builder /build/target/release/fwa-agentx /app/fwa-agentx

RUN chmod +x /app/universal-router \
            /app/cybergym_agentx \
            /app/pi_bench_agentx \
            /app/malt_agentx \
            /app/agentx-osworld \
            /app/fwa-agentx

RUN mkdir -p /work && chmod 755 /work

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 9009
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
